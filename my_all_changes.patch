+using System.ComponentModel;
+using Microsoft.AspNetCore.Http;
+using ModelContextProtocol.Server;
+
+namespace SqDbAiAgent.ConsoleApp.Services;
+
+[McpServerToolType]
+public sealed class McpDatabaseTools(
+    McpDatabaseService databaseService,
+    DatabaseContextService databaseContextService,
+    IHttpContextAccessor httpContextAccessor)
+{
+    [McpServerTool(Name = "get_database_schema")]
+    [Description("Returns the complete public database schema, including every available table, column, and inferred relationship. No security identity is required.")]
+    public async Task<string> GetDatabaseSchema(CancellationToken cancellationToken = default) =>
+        (await databaseContextService.GetAsync(cancellationToken)).SchemaPrompt;
+
+    [McpServerTool(Name = "list_security_users")]
+    [Description("Lists optional database security identities. An empty list or no selection permits data tools without an identity.")]
+    public Task<IReadOnlyList<McpSecurityUser>> ListSecurityUsers(
+        CancellationToken cancellationToken = default) =>
+        databaseService.ListSecurityUsersAsync(cancellationToken);
+
+    [McpServerTool(Name = "submit_sql")]
+    [Description("Validates and executes one final self-contained read-only Microsoft SQL Server query. A security identity is optional; without one, all available data is visible. No LLM repair is performed.")]
+    public Task<McpQueryResponse> SubmitSql(
+        [Description("The original user request this SQL is intended to answer.")] string userRequest,
+        [Description("One self-contained read-only Microsoft SQL Server query.")] string sql,
+        CancellationToken cancellationToken = default) =>
+        databaseService.SubmitAsync(this.GetHttpContext(), userRequest, sql, cancellationToken);
+
+    [McpServerTool(Name = "investigate_sql")]
+    [Description("Runs one narrow internal read-only evidence query. A security identity is optional; without one, all available data is visible.")]
+    public Task<McpQueryResponse> InvestigateSql(
+        [Description("The original user request that created the uncertainty.")] string userRequest,
+        [Description("The exact literal or filter uncertainty this probe resolves.")] string purpose,
+        [Description("A narrow read-only T-SQL query using TOP with a selective WHERE clause, or a single aggregate.")] string sql,
+        CancellationToken cancellationToken = default) =>
+        databaseService.InvestigateAsync(
+            this.GetHttpContext(),
+            userRequest,
+            purpose,
+            sql,
+            cancellationToken);
+
+    private HttpContext GetHttpContext() =>
+        httpContextAccessor.HttpContext
+        ?? throw new InvalidOperationException("The MCP request HTTP context is unavailable.");
+}
diff --git a/SqDbAiAgent.Console/Services/McpServerHost.cs b/SqDbAiAgent.Console/Services/McpServerHost.cs
new file mode 100644
index 0000000..ea0372b
--- /dev/null
